    "@angular/localize": "^21.2.14",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.14",
    "@angular/ssr": "^21.2.15",
    "@jsverse/transloco": "^8.4.0",
    "express": "^5.1.0",
    "marked": "^18.0.4",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.12",
